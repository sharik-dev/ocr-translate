default_platform(:ios)

# Reusable App Store Connect credentials (stored once, shared across projects)
CICD = File.expand_path("~/.config/ios-testflight-cicd")

APP_IDENTIFIER = "sharik.meowToon"
TEAM_ID        = "2XR666D9B2"
SCHEME         = "meowToon"
PROJECT        = "meowToon.xcodeproj"

def load_config
  config = {}
  File.foreach(File.join(CICD, "config.env")) do |line|
    next if line.strip.empty? || line.strip.start_with?("#")
    k, v = line.strip.split("=", 2)
    config[k] = v
  end
  config
end

def asc_api_key(config)
  app_store_connect_api_key(
    key_id: config["ASC_KEY_ID"],
    issuer_id: config["ASC_ISSUER_ID"],
    key_filepath: config["ASC_KEY_P8_PATH"],
    in_house: false,
  )
end

platform :ios do
  # ── Marketing screenshots (run locally from the terminal) ───────────────
  desc "Capture App Store screenshots via the UITest target"
  lane :screenshots do
    capture_screenshots(
      project: PROJECT,
      scheme: "meowToonUITests",
      output_directory: "./fastlane/screenshots",
      clear_previous_screenshots: true,
      launch_arguments: ["-UITestMode YES"],
    )
  end

  # ── Create the app record on App Store Connect (run once) ───────────────
  desc "Register the bundle id + create the app on App Store Connect"
  lane :create_app do
    config = load_config
    # Sets Spaceship::ConnectAPI.token from the App Store Connect API key.
    asc_api_key(config)

    # 1. Register the bundle id in the Developer portal (idempotent).
    bundle = Spaceship::ConnectAPI::BundleId.all.find { |b| b.identifier == APP_IDENTIFIER }
    if bundle.nil?
      bundle = Spaceship::ConnectAPI::BundleId.create(name: "meowToon", identifier: APP_IDENTIFIER, platform: "IOS")
      UI.success("Registered bundle id #{APP_IDENTIFIER}")
    else
      UI.message("Bundle id #{APP_IDENTIFIER} already registered")
    end

    # 2. Create the app record on App Store Connect (skip if it already exists).
    existing = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    if existing
      UI.message("App #{APP_IDENTIFIER} already exists on App Store Connect")
    else
      Spaceship::ConnectAPI::App.create(
        name: "meowToon",
        version_string: "1.0",
        sku: "meowToon-2026",
        primary_locale: "fr-FR",
        bundle_id: APP_IDENTIFIER,
        platforms: ["IOS"],
      )
      UI.success("Created app meowToon on App Store Connect")
    end
  end

  # ── Upload App Store metadata + screenshots (no review submission) ───────
  desc "Push App Store listing text + marketing screenshots (draft, no submit)"
  lane :metadata do
    config  = load_config
    api_key = asc_api_key(config)
    deliver(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      metadata_path: "./fastlane/metadata",
      screenshots_path: "./fastlane/store-screenshots",
      skip_binary_upload: true,
      overwrite_screenshots: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true,
    )
  end

  # ── Build & upload to TestFlight ────────────────────────────────────────
  desc "Build a signed release and upload it to TestFlight"
  lane :beta do
    config  = load_config
    api_key = asc_api_key(config)
    ENV["MATCH_PASSWORD"] ||= config["MATCH_PASSWORD"]

    # Bump build number to the next TestFlight value to avoid collisions
    build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      initial_build_number: 0,
    ) + 1
    increment_build_number(xcodeproj: PROJECT, build_number: build)

    # Signing via fastlane match (shared certs repo)
    match(
      type: "appstore",
      app_identifier: APP_IDENTIFIER,
      team_id: TEAM_ID,
      git_url: config["MATCH_GIT_URL"],
      readonly: false,
      api_key: api_key,
    )

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build",
      clean: true,
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      skip_waiting_for_build_processing: true,
    )
  end
end
